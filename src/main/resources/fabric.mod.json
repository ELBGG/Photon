{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "KilaBash"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.lowdragmc.photon.Photon"
    ],
    "client": [
      "com.lowdragmc.photon.client.PhotonClientProxy"
    ]
  },
  "mixins": [
    "photon.mixins.json"
  ],
  "accessWidener": "photon.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "ldlib2": "*",
    "special-model-loader": "*"
  }
}
